# Audiolingo environment variables
# Copy this file to .env.local and fill in values.

# Next.js public site URL (used for absolute links, OG tags, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Future: authentication provider (e.g., Clerk, Auth.js, Supabase)
# AUTH_SECRET=
# AUTH_PROVIDER_ID=

# Future: database / persistence backend
# DATABASE_URL=

# Future: analytics
# NEXT_PUBLIC_ANALYTICS_ID=